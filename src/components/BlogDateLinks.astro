---
import { blogMonthName } from "@/utils/blog";

const { year, month, day, lang } = Astro.props as {
  year: string;
  month: string;
  day: string;
  lang: "en" | "ja";
};
const base = lang === "ja" ? "/ja/blog/" : "/blog/";
---

<style>
  a {
    text-decoration: underline;

    &:hover {
      text-decoration: none;
    }
  }
</style>

{
  lang === "ja" ? (
    <span>
      <a href={base + year}>{year}</a>年
      <a href={`${base}${year}/${month}`}>{month}</a>月
      <a href={`${base}${year}/${month}/${day}`}>{day}</a>日
    </span>
  ) : (
    <span>
      <a href={`${base}${year}/${month}/${day}`}>{day}</a>{" "}
      <a href={`${base}${year}/${month}`}>{blogMonthName(month)}</a>{" "}
      <a href={base + year}>{year}</a>
    </span>
  )
}
