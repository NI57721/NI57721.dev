---
const { count } = Astro.props;
---

<style lang="scss" define:vars={{ count }}>
  div {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(var(--count), 1fr);
    @include mixin.mobile-view {
      grid-template-columns: repeat(1, 1fr);
    }
  }
</style>

<div>
  <slot />
</div>
