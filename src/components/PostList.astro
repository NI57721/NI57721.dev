---
import { getCollection } from "astro:content";
import BlogDateLinks from "@/components/BlogDateLinks.astro";

const { lang, year, month, day } = Astro.props as {
  lang: "en" | "ja";
  year?: string;
  month?: string;
  day?: string;
};
const collection = lang === "ja" ? "postsJa" : "postsEn";
const base = lang === "ja" ? "/ja/blog/" : "/blog/";
const posts = (await getCollection(collection))
  .filter((post) => {
    const [postYear, postMonth, postDay] = post.id.split("/");
    return (
      (!year || postYear === year) &&
      (!month || postMonth === month) &&
      (!day || postDay === day)
    );
  })
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<style lang="scss">
  ul {
    list-style-type: disc;
    padding-left: 20px;
    @include mixin.mobile-view {
      padding-left: 3vw;
    }
  }
  ul > li {
    margin-bottom: 4px;
    @include mixin.mobile-view {
      margin-bottom: 1vw;
    }
  }
  ul > li > a {
    text-decoration: underline;
    &:hover {
      text-decoration: none;
    }
  }
</style>

<ul>
  {
    posts.map((post) => {
      const [postYear, postMonth, postDay] = post.id.split("/");
      return (
        <li>
          <a transition:name={post.id} href={base + post.id}>
            {post.data.title}
          </a>
          {" - "}
          <BlogDateLinks
            year={postYear}
            month={postMonth}
            day={postDay}
            lang={lang}
          />
        </li>
      );
    })
  }
</ul>
