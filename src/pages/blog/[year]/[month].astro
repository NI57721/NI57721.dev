---
import { getCollection } from "astro:content";
import ArchivePage from "@/components/ArchivePage.astro";

export async function getStaticPaths() {
  const posts = await getCollection("postsEn");
  const paths = new Set(
    posts.map((post) => post.id.split("/").slice(0, 2).join("/")),
  );
  return [...paths].map((path) => {
    const [year, month] = path.split("/");
    return { params: { year, month } };
  });
}

const { year, month } = Astro.params;
---

<ArchivePage lang="en" year={year} month={month} />
