---
import Base from "@/layouts/Base.astro";
import TagList from "@/components/TagList.astro";

const title = "Log";
---

<style lang="scss">
  h2 {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 4px;
    @include mixin.mobile-view {
      margin-bottom: 2vw;
    }
  }

  section {
    margin-bottom: 16px;
    @include mixin.mobile-view {
      margin-bottom: 3vw;
    }
  }
</style>

<Base title={title}>
  <section>
    <h2>All Tags</h2>
    <TagList lang="en" />
  </section>
</Base>
